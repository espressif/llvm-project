# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Contract for QR/QR_64 physical-register COPY lowering in copyPhysReg and
# isCopyInstrImpl (RISCVInstrInfo.cpp), on PIE 2.2 (ESPV22) and PIE 2.1 (ESPV21).
#
# 1. A QR_64 -> QR_64 copy has no dedicated instruction. Unless fact 4
#    applies, copyPhysReg emits per 64-bit lane 2x (ESP_MOVI_32_A out to a
#    GPRPIE scratch + ESP_MOVI_32_Q writeback, which reads the rest of the
#    Q register as a tied operand).
# 2. The scratch GPRPIE is picked first-free from X24..X31 then X8..X15;
#    with all free the choice is $x24. A live-in on $x24 would force the
#    next candidate ($x25) - locked by qr64copy_scratch_skip.
# 3. A full 128-bit QR -> QR copy is a single idempotent `esp.orq qd, qs, qs`
#    (PIE manual: qz = qx | qy, so x | x = x): ESP_ORQ on PIE 2.1,
#    ESP_ORQ_2P2 on pure PIE 2.2. No GPR scratch is consumed.
# 4. A same-lane QR_64 -> QR_64 copy whose destination other half is dead
#    across the copy lowers to one full-width idempotent orq on the
#    super-registers (writes the wanted half bit-exactly, clobbers only a
#    dead half). Cross-lane copies, or a live destination other half, keep
#    the MOVI bridge (negative controls below).
#
# NOTE for MIR test authors: a COPY between *virtual* registers of an
# unrecognized class hits llvm_unreachable("Impossible reg-to-reg copy")
# in copyPhysReg when run under -run-pass=postrapseudos. Post-RA copies are
# always physical in production; use physical registers and liveins here.

# RUN: llc -mtriple=riscv32-esp-unknown-elf -mattr=+xespv2p2,+espv-lowering \
# RUN:   -run-pass=postrapseudos -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefixes=CHECK,ESPV22
# RUN: llc -mtriple=riscv32-esp-unknown-elf -mattr=+xespv2p1,+espv-lowering \
# RUN:   -run-pass=postrapseudos -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefixes=CHECK,ESPV21
# RUN: llc -mtriple=riscv32-esp-unknown-elf -mattr=+xespv2p2,+espv-lowering \
# RUN:   -run-pass=postrapseudos,machine-cp -mcp-use-is-copy-instr \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=MCP,MCP22
# RUN: llc -mtriple=riscv32-esp-unknown-elf -mattr=+xespv2p1,+espv-lowering \
# RUN:   -run-pass=postrapseudos,machine-cp -mcp-use-is-copy-instr \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=MCP,MCP21

#
# Same-lane low half, q1_d1 undefined before the copy (even with a downstream
# super-register read of $q1): single orq, no scratch.
---
name:            qr64copy
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
body:             |
  bb.0:
    liveins: $q0
    ; ESPV22-LABEL: name: qr64copy
    ; ESPV22: liveins: $q0
    ; ESPV22-NEXT: {{  $}}
    ; ESPV22-NEXT: $q1 = ESP_ORQ_2P2 $q0, $q0
    ; ESPV22-NEXT: PseudoRET implicit $q1
    ;
    ; ESPV21-LABEL: name: qr64copy
    ; ESPV21: liveins: $q0
    ; ESPV21-NEXT: {{  $}}
    ; ESPV21-NEXT: $q1 = ESP_ORQ $q0, $q0
    ; ESPV21-NEXT: PseudoRET implicit $q1
    ;
    ; MCP22-LABEL: name: qr64copy
    ; MCP22: liveins: $q0
    ; MCP22-NEXT: {{  $}}
    ; MCP22-NEXT: $q1 = ESP_ORQ_2P2 $q0, $q0
    ; MCP22-NEXT: PseudoRET implicit $q1
    ;
    ; MCP21-LABEL: name: qr64copy
    ; MCP21: liveins: $q0
    ; MCP21-NEXT: {{  $}}
    ; MCP21-NEXT: $q1 = ESP_ORQ $q0, $q0
    ; MCP21-NEXT: PseudoRET implicit $q1
    $q1_d0 = COPY $q0_d0
    PseudoRET implicit $q1
...

#
# Same-lane high half on upper-bound Q7_D1, q7_d0 dead across the copy: single
# orq.
---
name:            qr64copy_hi
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
body:             |
  bb.0:
    liveins: $q0
    ; ESPV22-LABEL: name: qr64copy_hi
    ; ESPV22: liveins: $q0
    ; ESPV22-NEXT: {{  $}}
    ; ESPV22-NEXT: $q7 = ESP_ORQ_2P2 $q0, $q0
    ; ESPV22-NEXT: PseudoRET implicit $q7_d1
    ;
    ; ESPV21-LABEL: name: qr64copy_hi
    ; ESPV21: liveins: $q0
    ; ESPV21-NEXT: {{  $}}
    ; ESPV21-NEXT: $q7 = ESP_ORQ $q0, $q0
    ; ESPV21-NEXT: PseudoRET implicit $q7_d1
    ;
    ; MCP22-LABEL: name: qr64copy_hi
    ; MCP22: liveins: $q0
    ; MCP22-NEXT: {{  $}}
    ; MCP22-NEXT: $q7 = ESP_ORQ_2P2 $q0, $q0
    ; MCP22-NEXT: PseudoRET implicit $q7_d1
    ;
    ; MCP21-LABEL: name: qr64copy_hi
    ; MCP21: liveins: $q0
    ; MCP21-NEXT: {{  $}}
    ; MCP21-NEXT: $q7 = ESP_ORQ $q0, $q0
    ; MCP21-NEXT: PseudoRET implicit $q7_d1
    $q7_d1 = COPY $q0_d1
    PseudoRET implicit $q7_d1
...

#
# q1_d1 is live-in and read after the copy (full q1 copy below), so orq
# would clobber it: keep the lane-wise MOVI bridge.
---
name:            qr64copy_live_other
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
  - { reg: '$q1' }
body:             |
  bb.0:
    liveins: $q0, $q1
    ; ESPV22-LABEL: name: qr64copy_live_other
    ; ESPV22: liveins: $q0, $q1
    ; ESPV22-NEXT: {{  $}}
    ; ESPV22-NEXT: $x24 = ESP_MOVI_32_A $q0, 0
    ; ESPV22-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 0
    ; ESPV22-NEXT: $x24 = ESP_MOVI_32_A $q0, 1
    ; ESPV22-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 1
    ; ESPV22-NEXT: $q3 = ESP_ORQ_2P2 $q1, $q1
    ; ESPV22-NEXT: PseudoRET implicit $q3
    ;
    ; ESPV21-LABEL: name: qr64copy_live_other
    ; ESPV21: liveins: $q0, $q1
    ; ESPV21-NEXT: {{  $}}
    ; ESPV21-NEXT: $x24 = ESP_MOVI_32_A $q0, 0
    ; ESPV21-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 0
    ; ESPV21-NEXT: $x24 = ESP_MOVI_32_A $q0, 1
    ; ESPV21-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 1
    ; ESPV21-NEXT: $q3 = ESP_ORQ $q1, $q1
    ; ESPV21-NEXT: PseudoRET implicit $q3
    ;
    ; MCP22-LABEL: name: qr64copy_live_other
    ; MCP22: liveins: $q0, $q1
    ; MCP22-NEXT: {{  $}}
    ; MCP22-NEXT: $x24 = ESP_MOVI_32_A $q0, 0
    ; MCP22-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 0
    ; MCP22-NEXT: $x24 = ESP_MOVI_32_A $q0, 1
    ; MCP22-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 1
    ; MCP22-NEXT: $q3 = ESP_ORQ_2P2 $q1, $q1
    ; MCP22-NEXT: PseudoRET implicit $q3
    ;
    ; MCP21-LABEL: name: qr64copy_live_other
    ; MCP21: liveins: $q0, $q1
    ; MCP21-NEXT: {{  $}}
    ; MCP21-NEXT: $x24 = ESP_MOVI_32_A $q0, 0
    ; MCP21-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 0
    ; MCP21-NEXT: $x24 = ESP_MOVI_32_A $q0, 1
    ; MCP21-NEXT: $q1 = ESP_MOVI_32_Q $q1, killed $x24, 1
    ; MCP21-NEXT: $q3 = ESP_ORQ $q1, $q1
    ; MCP21-NEXT: PseudoRET implicit $q3
    $q1_d0 = COPY $q0_d0
    $q3 = COPY $q1
    PseudoRET implicit $q3
...

#
# Cross-lane copy (q0_d1 -> q2_d0) cannot use orq, so it bridges lanes 2,3
# into lanes 0,1. $q2 is undefined before the copy so the first ESP_MOVI_32_Q
# marks $q2 undef even though PseudoRET reads $q2. $x24 is live past the copy
# point (read by the trailing ADDI), so the scratch scan skips it and picks
# the next candidate $x25.
---
name:            qr64copy_scratch_skip
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
  - { reg: '$x24' }
body:             |
  bb.0:
    liveins: $q0, $x24
    ; CHECK-LABEL: name: qr64copy_scratch_skip
    ; CHECK: liveins: $q0, $x24
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x25 = ESP_MOVI_32_A $q0, 2
    ; CHECK-NEXT: $q2 = ESP_MOVI_32_Q undef $q2, killed $x25, 0
    ; CHECK-NEXT: $x25 = ESP_MOVI_32_A $q0, 3
    ; CHECK-NEXT: $q2 = ESP_MOVI_32_Q $q2, killed $x25, 1
    ; CHECK-NEXT: dead $x25 = ADDI $x24, 0
    ; CHECK-NEXT: PseudoRET implicit $q2
    ;
    ; MCP-LABEL: name: qr64copy_scratch_skip
    ; MCP: liveins: $q0, $x24
    ; MCP-NEXT: {{  $}}
    ; MCP-NEXT: $x25 = ESP_MOVI_32_A $q0, 2
    ; MCP-NEXT: $q2 = ESP_MOVI_32_Q undef $q2, killed $x25, 0
    ; MCP-NEXT: $x25 = ESP_MOVI_32_A $q0, 3
    ; MCP-NEXT: $q2 = ESP_MOVI_32_Q $q2, killed $x25, 1
    ; MCP-NEXT: PseudoRET implicit $q2
    $q2_d0 = COPY $q0_d1
    dead $x25 = ADDI $x24, 0
    PseudoRET implicit $q2
...

#
# Full 128-bit QR copy lowers to one idempotent orq: q2 = q0 | q0.
---
name:            qrfullcopy
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
body:             |
  bb.0:
    liveins: $q0
    ; ESPV22-LABEL: name: qrfullcopy
    ; ESPV22: liveins: $q0
    ; ESPV22-NEXT: {{  $}}
    ; ESPV22-NEXT: $q2 = ESP_ORQ_2P2 $q0, $q0
    ; ESPV22-NEXT: PseudoRET implicit $q2
    ;
    ; ESPV21-LABEL: name: qrfullcopy
    ; ESPV21: liveins: $q0
    ; ESPV21-NEXT: {{  $}}
    ; ESPV21-NEXT: $q2 = ESP_ORQ $q0, $q0
    ; ESPV21-NEXT: PseudoRET implicit $q2
    ;
    ; MCP22-LABEL: name: qrfullcopy
    ; MCP22: liveins: $q0
    ; MCP22-NEXT: {{  $}}
    ; MCP22-NEXT: $q2 = ESP_ORQ_2P2 $q0, $q0
    ; MCP22-NEXT: PseudoRET implicit $q2
    ;
    ; MCP21-LABEL: name: qrfullcopy
    ; MCP21: liveins: $q0
    ; MCP21-NEXT: {{  $}}
    ; MCP21-NEXT: $q2 = ESP_ORQ $q0, $q0
    ; MCP21-NEXT: PseudoRET implicit $q2
    $q2 = COPY $q0
    PseudoRET implicit $q2
...

#
# QR -> high QR_64 half extracts sub_qr_64_hi. The QR_64 enums interleave
# (Q0_D0, Q0_D1, Q1_D0, ...), so a range-based lane test used to classify
# Q0_D1..Q6_D1 as low halves and extract the wrong half.
---
name:            qr_to_qr64_hi
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
body:             |
  bb.0:
    liveins: $q0
    ; CHECK-LABEL: name: qr_to_qr64_hi
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q3_d1 = EXTRACT_SUBREG $q0, %subreg.sub_qr_64_hi
    ; CHECK-NEXT: PseudoRET implicit $q3_d1
    ;
    ; MCP-LABEL: name: qr_to_qr64_hi
    ; MCP: liveins: $q0
    ; MCP-NEXT: {{  $}}
    ; MCP-NEXT: $q3_d1 = EXTRACT_SUBREG $q0, %subreg.sub_qr_64_hi
    ; MCP-NEXT: PseudoRET implicit $q3_d1
    $q3_d1 = COPY $q0
    PseudoRET implicit $q3_d1
...

#
# High QR_64 half (Q7_D1) -> QR inserts sub_qr_64_hi; copying into its own
# super-register ($q7 = COPY $q7_d1) is a no-op.
---
name:            qr64_to_qr_hi
tracksRegLiveness: true
liveins:
  - { reg: '$q3' }
  - { reg: '$q7' }
body:             |
  bb.0:
    liveins: $q3, $q7
    ; CHECK-LABEL: name: qr64_to_qr_hi
    ; CHECK: liveins: $q3, $q7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q3 = INSERT_SUBREG $q3, $q7_d1, %subreg.sub_qr_64_hi
    ; CHECK-NEXT: PseudoRET implicit $q3, implicit $q7
    ;
    ; MCP-LABEL: name: qr64_to_qr_hi
    ; MCP: liveins: $q3, $q7
    ; MCP-NEXT: {{  $}}
    ; MCP-NEXT: $q3 = INSERT_SUBREG $q3, $q7_d1, %subreg.sub_qr_64_hi
    ; MCP-NEXT: PseudoRET implicit $q3, implicit $q7
    $q3 = COPY $q7_d1
    $q7 = COPY $q7_d1
    PseudoRET implicit $q3, implicit $q7
...

#
# Cross-lane copy inside one QR (q0_d1 -> q0_d0): the destination other half
# is the source, so the bridge must keep reading $q0 (no undef, no orq).
---
name:            qr64copy_same_super
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
body:             |
  bb.0:
    liveins: $q0
    ; CHECK-LABEL: name: qr64copy_same_super
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x24 = ESP_MOVI_32_A $q0, 2
    ; CHECK-NEXT: $q0 = ESP_MOVI_32_Q $q0, killed $x24, 0
    ; CHECK-NEXT: $x24 = ESP_MOVI_32_A $q0, 3
    ; CHECK-NEXT: $q0 = ESP_MOVI_32_Q $q0, killed $x24, 1
    ; CHECK-NEXT: PseudoRET implicit $q0_d0
    ;
    ; MCP-LABEL: name: qr64copy_same_super
    ; MCP: liveins: $q0
    ; MCP-NEXT: {{  $}}
    ; MCP-NEXT: $x24 = ESP_MOVI_32_A $q0, 2
    ; MCP-NEXT: $q0 = ESP_MOVI_32_Q $q0, killed $x24, 0
    ; MCP-NEXT: $x24 = ESP_MOVI_32_A $q0, 3
    ; MCP-NEXT: $q0 = ESP_MOVI_32_Q $q0, killed $x24, 1
    ; MCP-NEXT: PseudoRET implicit $q0_d0
    $q0_d0 = COPY $q0_d1
    PseudoRET implicit $q0_d0
...

#
# isCopyInstrImpl recognizes idempotent ESP_ORQ / ESP_ORQ_2P2 (qx == qy) so
# machine-cp eliminates the redundant/dead QR copies, while preserving
# non-idempotent bitwise ORs (qx != qy).
---
name:            orq_is_copy_instr
tracksRegLiveness: true
liveins:
  - { reg: '$q0' }
  - { reg: '$q1' }
body:             |
  bb.0:
    liveins: $q0, $q1
    ; ESPV22-LABEL: name: orq_is_copy_instr
    ; ESPV22: liveins: $q0, $q1
    ; ESPV22-NEXT: {{  $}}
    ; ESPV22-NEXT: $q2 = ESP_ORQ_2P2 $q0, $q0
    ; ESPV22-NEXT: $q0 = ESP_ORQ_2P2 $q2, $q2
    ; ESPV22-NEXT: $q3 = ESP_ORQ $q0, $q1
    ; ESPV22-NEXT: $q4 = ESP_ORQ_2P2 $q0, $q1
    ; ESPV22-NEXT: PseudoRET implicit $q0, implicit $q3, implicit $q4
    ;
    ; ESPV21-LABEL: name: orq_is_copy_instr
    ; ESPV21: liveins: $q0, $q1
    ; ESPV21-NEXT: {{  $}}
    ; ESPV21-NEXT: $q2 = ESP_ORQ $q0, $q0
    ; ESPV21-NEXT: $q0 = ESP_ORQ $q2, $q2
    ; ESPV21-NEXT: $q3 = ESP_ORQ $q0, $q1
    ; ESPV21-NEXT: $q4 = ESP_ORQ_2P2 $q0, $q1
    ; ESPV21-NEXT: PseudoRET implicit $q0, implicit $q3, implicit $q4
    ;
    ; MCP-LABEL: name: orq_is_copy_instr
    ; MCP: liveins: $q0, $q1
    ; MCP-NEXT: {{  $}}
    ; MCP-NEXT: $q3 = ESP_ORQ $q0, $q1
    ; MCP-NEXT: $q4 = ESP_ORQ_2P2 $q0, $q1
    ; MCP-NEXT: PseudoRET implicit $q0, implicit $q3, implicit $q4
    $q2 = COPY $q0
    $q0 = COPY $q2
    $q3 = ESP_ORQ $q0, $q1
    $q4 = ESP_ORQ_2P2 $q0, $q1
    PseudoRET implicit $q0, implicit $q3, implicit $q4
...
