# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Physical SAR_BYTES <-> GPR copies must lower to the movx opcode of the
# active PIE version: the _2P2 defs on pure PIE 2.2, the base defs on PIE 2.1.
# RUN: llc -mtriple=riscv32-esp-unknown-elf -mcpu=esp32p4 -mattr=+espv-lowering \
# RUN:   -run-pass=postrapseudos -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefix=P22
# RUN: llc -mtriple=riscv32-esp-unknown-elf -mcpu=esp32p4eco4 -mattr=+espv-lowering \
# RUN:   -run-pass=postrapseudos -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefix=P21

---
name:            gpr_to_sar_bytes
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10
    ; P22-LABEL: name: gpr_to_sar_bytes
    ; P22: liveins: $x10
    ; P22-NEXT: {{  $}}
    ; P22-NEXT: $sar_bytes = ESP_MOVX_W_SAR_BYTES_2P2 $x10
    ; P22-NEXT: PseudoRET implicit $sar_bytes
    ;
    ; P21-LABEL: name: gpr_to_sar_bytes
    ; P21: liveins: $x10
    ; P21-NEXT: {{  $}}
    ; P21-NEXT: $sar_bytes = ESP_MOVX_W_SAR_BYTES $x10
    ; P21-NEXT: PseudoRET implicit $sar_bytes
    $sar_bytes = COPY $x10
    PseudoRET implicit $sar_bytes
...
---
name:            sar_bytes_to_gpr
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sar_bytes
    ; P22-LABEL: name: sar_bytes_to_gpr
    ; P22: liveins: $sar_bytes
    ; P22-NEXT: {{  $}}
    ; P22-NEXT: $x10 = ESP_MOVX_R_SAR_BYTES_2P2 $sar_bytes
    ; P22-NEXT: PseudoRET implicit $x10
    ;
    ; P21-LABEL: name: sar_bytes_to_gpr
    ; P21: liveins: $sar_bytes
    ; P21-NEXT: {{  $}}
    ; P21-NEXT: $x10 = ESP_MOVX_R_SAR_BYTES $sar_bytes
    ; P21-NEXT: PseudoRET implicit $x10
    $x10 = COPY $sar_bytes
    PseudoRET implicit $x10
...
