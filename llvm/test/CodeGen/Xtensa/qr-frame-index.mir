    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: ST_QR $q0, killed $a8, 0
    ; CHECK-NEXT: $a8 = MOVI 24
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: ST_QR $q0, killed $a8, 0
    ; CHECK-NEXT: $q1 = LD_QR $sp, 112
    ; CHECK-NEXT: $a8 = MOVI 128
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: $q1 = LD_QR killed $a8, 0
    ; CHECK-NEXT: $a8 = MOVI 24
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: $q1 = LD_QR killed $a8, 0
