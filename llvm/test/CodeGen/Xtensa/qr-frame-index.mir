# %stack.0 resolves to $sp + 16, so test 96 as the boundary.

---
name: ld_st_qr
tracksRegLiveness: true
stack:
  - { id: 0, size: 256, alignment: 16 }
body: |
  bb.0:
    liveins: $q0, $a0
